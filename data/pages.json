{"sites":[{"id":"cdm","slug":"cdm","name":"Collectes de déchets ménagers"}],"pages":[{"id":"cdm-validation-v040","siteSlug":"cdm","slug":"validation-v040","title":"CDM — Machine de contrôle v1.4","metaTitle":"CDM — Machine de contrôle","metaDescription":"Prototype interactif de contrôle, déploiement, archivage et traçabilité.","html":"<style>\nmain{max-width:none!important;padding:0!important}body{background:#07111f!important}.m{--b:#143b7d;--o:#d4af37;--p:#101c30;--p2:#162640;--l:#2b4161;--t:#f3f7ff;--u:#9db0ca;--g:#35d17e;--a:#ffb454;--r:#ff6b6b;min-height:100vh;background:radial-gradient(circle at 60% -15%,#203b68,#091423 45%,#050b14);color:var(--t);font:14px/1.45 Inter,system-ui,sans-serif}.m *{box-sizing:border-box}.sh{display:grid;grid-template-columns:225px 1fr;min-height:100vh}.side{background:#07101deb;border-right:1px solid var(--l);padding:20px 14px}.brand{display:flex;align-items:center;gap:10px;padding:4px 7px 20px}.logo{width:42px;height:42px;border:2px solid var(--o);border-radius:50%;display:grid;place-items:center;color:var(--o);font-weight:900}.brand b{font-size:17px}.brand small{display:block;color:var(--u)}.nav{display:grid;gap:5px}.nav button{border:0;background:transparent;color:var(--u);padding:11px;text-align:left;border-radius:9px;cursor:pointer}.nav button.on,.nav button:hover{background:#182b49;color:#fff}.rule{margin-top:18px;border:1px solid #59471d;background:#18160e;border-radius:11px;padding:13px;color:#d9cfaf;font-size:12px}.rule b{color:var(--o);display:block;margin-bottom:5px}.top{height:64px;display:flex;justify-content:space-between;align-items:center;padding:0 22px;border-bottom:1px solid var(--l);background:#0c1729e8;position:sticky;top:0;z-index:3}.top h1{font-size:16px;margin:0}.live{color:var(--g)}.ct{padding:20px;max-width:1420px;margin:auto}.pg{display:none}.pg.on{display:block}.hd{display:flex;justify-content:space-between;gap:15px;align-items:flex-start;margin-bottom:16px}.hd h2{margin:0 0 3px}.hd p{margin:0;color:var(--u)}.btn{border:1px solid #365784;background:#183c69;color:#fff;border-radius:9px;padding:9px 12px;font-weight:750;cursor:pointer}.btn.gold{background:#624c16;border-color:#967626;color:#ffe3a0}.btn.ghost{background:transparent}.kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.card{background:linear-gradient(145deg,var(--p2),var(--p));border:1px solid var(--l);border-radius:13px;padding:15px;box-shadow:0 10px 28px #0003}.k small{color:var(--u);text-transform:uppercase;font-size:10px;letter-spacing:.06em}.k strong{display:block;font-size:27px;margin:5px 0}.good{color:var(--g)}.bad{color:var(--r)}.lay{display:grid;grid-template-columns:1fr 290px;gap:12px;margin-top:12px}.stack{display:grid;gap:12px}.ttl{margin:0 0 10px;color:var(--o);font-size:12px;letter-spacing:.05em}.tw{display:grid;grid-template-columns:1fr 1fr;gap:12px}.th{overflow:auto;border:1px solid var(--l);border-radius:10px}table{width:100%;border-collapse:collapse;min-width:760px}th,td{padding:10px 11px;border-bottom:1px solid #233652;text-align:left}th{font-size:10px;color:var(--u);text-transform:uppercase;background:#0d182a}.st{display:inline-flex;align-items:center;gap:6px;font-weight:800}.dot{width:8px;height:8px;border-radius:50%;background:var(--g)}.badge{padding:4px 7px;border-radius:99px;background:#193d2a;color:#84edaf;font-size:11px;font-weight:800}.quick{display:grid;gap:8px}.quick .btn{text-align:left;padding:12px}.quick small{display:block;color:var(--u);font-weight:400}.checks{display:grid;gap:8px}.checks span{color:var(--g);font-weight:900}.log{display:grid;gap:7px;max-height:260px;overflow:auto}.lr{display:grid;grid-template-columns:65px 1fr auto;gap:8px;padding-bottom:7px;border-bottom:1px solid #233652}.tm{color:var(--u)}.res{color:var(--g);font-weight:800}.ring{width:112px;height:112px;border-radius:50%;background:conic-gradient(var(--g) 100%,#263650 0);display:grid;place-items:center;position:relative;margin:auto}.ring:before{content:'';position:absolute;inset:10px;border-radius:50%;background:var(--p)}.ring b{position:relative;font-size:25px}.center{text-align:center}.center h3{color:var(--g);margin:12px 0 3px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.repo h3{margin:0 0 3px}.repo p{margin:0;color:var(--u)}.meta{display:grid;gap:7px;margin-top:12px}.meta div{display:flex;justify-content:space-between;border-bottom:1px solid #233652;padding-bottom:6px}.acts{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}.sw{display:flex;justify-content:space-between;align-items:center;padding:11px 0;border-bottom:1px solid #233652}.tg{width:42px;height:23px;border-radius:99px;background:#2b3b52;position:relative;cursor:pointer}.tg:after{content:'';position:absolute;width:17px;height:17px;border-radius:50%;background:#fff;left:3px;top:3px;transition:.2s}.tg.on{background:#1f7549}.tg.on:after{left:22px}.form{display:grid;gap:10px}.form label{display:grid;gap:5px;color:var(--u)}.form input,.form select{background:#0b1627;color:#fff;border:1px solid var(--l);border-radius:8px;padding:10px}.toast{position:fixed;right:18px;bottom:18px;background:#103022;border:1px solid #359664;padding:11px 14px;border-radius:9px;opacity:0;transform:translateY(10px);transition:.2s;pointer-events:none}.toast.on{opacity:1;transform:none}@media(max-width:1050px){.kpis{grid-template-columns:repeat(3,1fr)}.lay{grid-template-columns:1fr}.grid3{grid-template-columns:1fr 1fr}}@media(max-width:720px){.sh{grid-template-columns:1fr}.side{border-right:0;border-bottom:1px solid var(--l)}.nav{grid-template-columns:repeat(3,1fr)}.top{position:static}.tw,.grid3{grid-template-columns:1fr 1fr}}@media(max-width:500px){.ct{padding:13px}.kpis,.tw,.grid3{grid-template-columns:1fr}.nav{grid-template-columns:1fr 1fr}.hd{flex-direction:column}}\n</style><div class='m'><div class='sh'><aside class='side'><div class='brand'><div class='logo'>CDM</div><div><b>MACHINE</b><small>Contrôle & déploiement</small></div></div><nav class='nav'><button class='on' data-p='dash'>⌂ Tableau de bord</button><button data-p='repos'>▱ Dépôts</button><button data-p='ctrl'>✓ Contrôles</button><button data-p='dep'>☁ Déploiements</button><button data-p='drv'>△ Drive</button><button data-p='rep'>▤ Rapports</button><button data-p='rules'>⚙ Règles</button></nav><div class='rule'><b>RÈGLE D’EXÉCUTION</b>Travail continu et silencieux. Intervention humaine uniquement pour la validation finale ou une anomalie critique.</div></aside><section><header class='top'><h1>Machine de contrôle & déploiement maîtrisé</h1><span class='live'>● Agent actif</span></header><main class='ct'>\n<section class='pg on' id='dash'><div class='hd'><div><h2>Tableau de bord</h2><p>Supervision consolidée des dépôts, contrôles, déploiements et sauvegardes.</p></div><button class='btn gold' data-a='control'>Contrôle global</button></div><div class='kpis' id='kpis'></div><div class='lay'><div class='stack'><div class='card'><h3 class='ttl'>DÉPÔTS & ÉTAT GLOBAL</h3><div class='th'><table><thead><tr><th>Dépôt</th><th>Statut</th><th>Contrôle</th><th>Render</th><th>Drive</th><th>Action</th></tr></thead><tbody id='rows'></tbody></table></div></div><div class='tw'><div class='card'><h3 class='ttl'>JOURNAL D’ACTIVITÉ</h3><div class='log' id='log'></div></div><div class='card center'><h3 class='ttl'>QUALITÉ GLOBALE</h3><div class='ring'><b id='score'>100%</b></div><h3>OPÉRATIONNELLE</h3><p id='qtxt'>Aucune anomalie critique</p></div></div></div><aside class='stack'><div class='card'><h3 class='ttl'>ACTIONS RAPIDES</h3><div class='quick'><button class='btn' data-a='control'>Contrôle global<small>197 vérifications</small></button><button class='btn' data-a='deploy'>Déployer tout<small>Relancer les services Render</small></button><button class='btn' data-a='backup'>Sauvegarder Drive<small>Créer une archive complète</small></button><button class='btn' data-a='report'>Rapport complet<small>Tracer l’exécution</small></button></div></div><div class='card'><h3 class='ttl'>RÈGLES DE LA MACHINE</h3><div class='checks'><div><span>✓</span> Contrôle automatique toutes les 10 min</div><div><span>✓</span> Sauvegarde Drive toutes les 2 h</div><div><span>✓</span> Relance après 5 min d’inactivité</div><div><span>✓</span> Fonctionnement 24/24 — 7/7</div></div></div></aside></div></section>\n<section class='pg' id='repos'><div class='hd'><div><h2>Dépôts surveillés</h2><p>État détaillé des projets suivis.</p></div><button class='btn' id='add'>Ajouter un dépôt</button></div><div class='grid3' id='cards'></div></section>\n<section class='pg' id='ctrl'><div class='hd'><div><h2>Contrôles automatiques</h2><p>Qualité, sécurité, liens, manifestes, API et responsive.</p></div><button class='btn gold' data-a='control'>Exécuter</button></div><div class='tw'><div class='card' id='checks'></div><div class='card center'><div class='ring'><b>197</b></div><h3>197 / 197 OK</h3><p>Dernière exécution complète</p></div></div></section>\n<section class='pg' id='dep'><div class='hd'><div><h2>Déploiements Render</h2><p>Versions, santé et relances.</p></div><button class='btn gold' data-a='deploy'>Déployer tout</button></div><div class='card'><div class='th'><table><thead><tr><th>Service</th><th>Version</th><th>Statut</th><th>Santé</th><th>Action</th></tr></thead><tbody id='deps'></tbody></table></div></div></section>\n<section class='pg' id='drv'><div class='hd'><div><h2>Archivage Drive</h2><p>Copies, journaux, manifestes et validations.</p></div><button class='btn gold' data-a='backup'>Sauvegarder</button></div><div class='grid3' id='drive'></div></section>\n<section class='pg' id='rep'><div class='hd'><div><h2>Rapports & traçabilité</h2><p>Historique des contrôles et de la production.</p></div><button class='btn gold' data-a='report'>Générer</button></div><div class='card'><div class='th'><table><thead><tr><th>Rapport</th><th>Date</th><th>Périmètre</th><th>Résultat</th></tr></thead><tbody id='reports'></tbody></table></div></div></section>\n<section class='pg' id='rules'><div class='hd'><div><h2>Règles & paramètres</h2><p>Configuration du prototype.</p></div><button class='btn gold' id='save'>Enregistrer</button></div><div class='tw'><div class='card' id='switches'></div><div class='card'><form class='form'><label>Fréquence de contrôle<select><option>5 minutes</option><option selected>10 minutes</option><option>30 minutes</option></select></label><label>Fréquence de sauvegarde<select><option>1 heure</option><option selected>2 heures</option><option>6 heures</option></select></label><label>Seuil d’alerte<input value='1 anomalie critique'></label><label>Mode de validation<select><option>Validation humaine finale</option><option>Validation par lot</option></select></label></form></div></div></section>\n</main></section></div><div class='toast' id='toast'></div></div><script>\n(()=>{const K='cdm-machine-preview-v14',seed={repos:[['app','APPLICATION PRIVÉE LMI','app.lesmotsimages.com','v1.0.0'],['sat','LA REVUE DES SATIRES','revue.lesmotsimages.com','v2.0.0'],['eni','ÉNIGMES DE MÉMOIRE','enigmes.lesmotsimages.com','v1.3.0'],['duo','LMI DUO','duo.lesmotsimages.com','v0.8.0'],['rok','ROKKU','rokku.lesmotsimages.com','v2.1.0'],['gor','GORÉE — LA PORTE DU RETOUR','goree.lesmotsimages.com','v0.6.0'],['hub','LMI SITE HUB','www.lesmotsimages.com','v3.0.0']].map(x=>({id:x[0],name:x[1],domain:x[2],version:x[3],status:'ok',render:'En ligne',control:'12:40'})),logs:[['12:40','Contrôle global terminé','197/197 OK'],['12:38','Sauvegarde Drive complète','OK'],['12:36','Déploiement Render','OK']],reports:[['Rapport global CDM','Aujourd’hui','7 dépôts','197/197 OK']],rules:{control:true,backup:true,restart:true,quiet:true,human:true}};let s;try{s=JSON.parse(localStorage.getItem(K))||seed}catch{s=seed}const $=q=>document.querySelector(q),save=()=>localStorage.setItem(K,JSON.stringify(s)),esc=x=>String(x).replace(/[&<>\"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#039;'}[m])),toast=x=>{let e=$('#toast');e.textContent=x;e.classList.add('on');setTimeout(()=>e.classList.remove('on'),1700)},now=()=>new Date().toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});function log(a,r='OK'){s.logs.unshift([now(),a,r]);s.logs=s.logs.slice(0,20)}function render(){let al=s.repos.filter(x=>x.status!=='ok').length;$('#kpis').innerHTML=[['Dépôts surveillés',s.repos.length,'Actifs'],['Contrôles aujourd’hui',197,'100% OK'],['Déploiements actifs',s.repos.filter(x=>x.render==='En ligne').length,'En ligne'],['Dernière sauvegarde','12:38','Drive'],['Alertes critiques',al,al?'À traiter':'Aucune']].map(x=>`<div class='card k'><small>${x[0]}</small><strong class='${x[1]===0?'good':''}'>${x[1]}</strong><span>${x[2]}</span></div>`).join('');let st=x=>`<span class='st'><i class='dot'></i>${x.status==='ok'?'OK':'Alerte'}</span>`;$('#rows').innerHTML=s.repos.map(x=>`<tr><td><b>${esc(x.name)}</b><br><small>${esc(x.domain)}</small></td><td>${st(x)}</td><td>${x.control}</td><td><span class='badge'>${x.render}</span></td><td>✓</td><td><button class='btn ghost' data-c='${x.id}'>Contrôler</button></td></tr>`).join('');$('#log').innerHTML=s.logs.map(x=>`<div class='lr'><span class='tm'>${x[0]}</span><span>${esc(x[1])}</span><span class='res'>${x[2]}</span></div>`).join('');$('#cards').innerHTML=s.repos.map(x=>`<article class='card repo'><h3>${esc(x.name)}</h3><p>${esc(x.domain)}</p><div class='meta'><div><span>Statut</span>${st(x)}</div><div><span>Version</span><b>${x.version}</b></div><div><span>Render</span><span class='badge'>${x.render}</span></div><div><span>Drive / GitHub</span><b>Connectés</b></div></div><div class='acts'><button class='btn' data-c='${x.id}'>Contrôler</button><button class='btn ghost' data-d='${x.id}'>Déployer</button></div></article>`).join('');$('#checks').innerHTML='<h3 class=\"ttl\">PLAN DE CONTRÔLE</h3>'+[['Liens internes et externes',42],['CTA et navigation',31],['Manifeste et intégrité',28],['Tests API et santé',36],['Responsive et accessibilité',24],['Sécurité et configuration',36]].map(x=>`<div class='sw'><b>${x[0]}</b><span class='badge'>${x[1]}/${x[1]} OK</span></div>`).join('');$('#deps').innerHTML=s.repos.map(x=>`<tr><td><b>${esc(x.name)}</b></td><td>${x.version}</td><td><span class='badge'>${x.render}</span></td><td>${st(x)}</td><td><button class='btn ghost' data-d='${x.id}'>Redéployer</button></td></tr>`).join('');$('#drive').innerHTML=[['Archives applicatives','28 fichiers'],['Rapports de contrôle','14 rapports'],['Manifestes & SHA','7 manifestes'],['Validations humaines','0 en attente'],['Journal de production','126 entrées'],['Documentation','18 documents']].map(x=>`<div class='card repo'><h3>${x[0]}</h3><p>${x[1]}</p><div class='acts'><button class='btn ghost'>Synchronisé</button></div></div>`).join('');$('#reports').innerHTML=s.reports.map(x=>`<tr><td><b>${x[0]}</b></td><td>${x[1]}</td><td>${x[2]}</td><td><span class='badge'>${x[3]}</span></td></tr>`).join('');let labels={control:'Contrôle automatique',backup:'Sauvegarde Drive automatique',restart:'Relance après inactivité',quiet:'Mode silencieux',human:'Validation humaine finale'};$('#switches').innerHTML='<h3 class=\"ttl\">AUTOMATISATIONS</h3>'+Object.entries(labels).map(([k,v])=>`<div class='sw'><b>${v}</b><i class='tg ${s.rules[k]?'on':''}' data-r='${k}'></i></div>`).join('');$('#score').textContent=(100-al*20)+'%';$('#qtxt').textContent=al?al+' anomalie(s) critique(s)':'Aucune anomalie critique';save()}document.querySelector('.nav').onclick=e=>{let b=e.target.closest('[data-p]');if(!b)return;document.querySelectorAll('[data-p]').forEach(x=>x.classList.toggle('on',x===b));document.querySelectorAll('.pg').forEach(x=>x.classList.toggle('on',x.id===b.dataset.p))};document.querySelector('.m').onclick=e=>{let b=e.target.closest('button,[data-r]');if(!b)return;if(b.dataset.c){let x=s.repos.find(y=>y.id===b.dataset.c);x.status='ok';x.control=now();log('Contrôle terminé — '+x.name,'197/197 OK');toast('Contrôle terminé')}if(b.dataset.d){let x=s.repos.find(y=>y.id===b.dataset.d);x.render='En ligne';log('Déploiement Render — '+x.name);toast('Déploiement terminé')}if(b.dataset.r){s.rules[b.dataset.r]=!s.rules[b.dataset.r];toast('Règle mise à jour')}if(b.dataset.a==='control'){s.repos.forEach(x=>{x.status='ok';x.control=now()});log('Contrôle global terminé','197/197 OK');toast('197 contrôles validés')}if(b.dataset.a==='deploy'){s.repos.forEach(x=>x.render='En ligne');log('Déploiement global Render');toast('Services redéployés')}if(b.dataset.a==='backup'){log('Sauvegarde Drive complète');toast('Archive Drive créée')}if(b.dataset.a==='report'){s.reports.unshift(['Rapport machine '+new Date().toLocaleDateString('fr-FR'),now(),s.repos.length+' dépôts','197/197 OK']);log('Rapport complet généré');toast('Rapport généré')}if(b.id==='add')toast('Ajout de dépôt prévu en production');if(b.id==='save'){log('Configuration enregistrée');toast('Règles enregistrées')}render()};render()})();\n</script>","markdown":"","status":"draft","version":4,"createdAt":"2026-08-01T10:50:00.000Z","updatedAt":"2026-08-01T13:45:00.000Z","reviewedAt":null,"approvedAt":null,"publishedAt":null,"history":[{"at":"2026-08-01T10:50:00.000Z","action":"created","status":"draft"},{"at":"2026-08-01T13:45:00.000Z","action":"machine-prototype-v1.4","status":"draft"}]}]}