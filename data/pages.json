    {
      "id": "cdm-validation-v040",
      "siteSlug": "cdm",
      "slug": "validation-v040",
      "title": "CDM — Validation humaine v0.4.0",
      "metaTitle": "CDM — Validation humaine",
      "metaDescription": "Application de pilotage des collectes de déchets ménagers.",
      "html": "<style>:root{--g:#0d6b4b;--g2:#084b36;--b:#edf5f1;--o:#cc7722;--r:#b42318;--t:#17231e}#cdm{font-family:Inter,system-ui,sans-serif;color:var(--t)}#cdm *{box-sizing:border-box}.hero{background:linear-gradient(135deg,var(--g2),var(--g));color:#fff;border-radius:20px;padding:28px;margin-bottom:20px}.hero h1{margin:0 0 7px;font-size:clamp(1.8rem,4vw,3rem)}.hero p{margin:0;opacity:.86}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}.tabs button,.btn{border:0;border-radius:10px;padding:11px 15px;font-weight:700;cursor:pointer}.tabs button{background:#e7eeea;color:#234437}.tabs button.active,.btn{background:var(--g);color:#fff}.btn.alt{background:#fff;color:var(--g);border:1px solid #a9c6b8}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.card{border:1px solid #dfe9e4;border-radius:15px;padding:17px;background:#fff;box-shadow:0 7px 24px #102d2010}.kpi strong{font-size:2rem;display:block;color:var(--g2)}.kpi span{color:#65756d}.panel{display:none}.panel.active{display:block}.bar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:22px 0 12px}.bar h2{margin:0}.form{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;background:var(--b);padding:15px;border-radius:14px;margin-bottom:14px}.form input,.form select{width:100%;padding:11px;border:1px solid #bdcec5;border-radius:9px;background:#fff}.form .btn{align-self:end}.tablewrap{overflow:auto;border:1px solid #dfe9e4;border-radius:14px}table{width:100%;border-collapse:collapse;background:#fff}th,td{padding:12px;text-align:left;border-bottom:1px solid #edf1ef;white-space:nowrap}th{font-size:.8rem;text-transform:uppercase;letter-spacing:.05em;background:#f5f8f6;color:#53675d}.badge{padding:5px 9px;border-radius:99px;font-size:.78rem;font-weight:800}.planifiee{background:#e8f1ff;color:#175cd3}.en_cours{background:#fff3dc;color:#9a5b00}.terminee,.disponible,.clos{background:#e5f8ef;color:#067647}.annulee,.indisponible,.critique{background:#fee4e2;color:#b42318}.ouvert,.moyenne{background:#fff1e5;color:#b54708}.actions{display:flex;gap:7px}.mini{border:0;border-radius:8px;padding:7px 9px;cursor:pointer;background:#e7eeea;color:#234437}.empty{padding:35px;text-align:center;color:#6c7e75}.footer{margin-top:18px;color:#6c7e75;font-size:.88rem}@media(max-width:850px){.grid{grid-template-columns:1fr 1fr}.form{grid-template-columns:1fr 1fr}}@media(max-width:520px){.grid,.form{grid-template-columns:1fr}.bar{align-items:flex-start;flex-direction:column}}</style><div id='cdm'><section class='hero'><h1>Collectes de déchets ménagers</h1><p>Tableau de pilotage opérationnel · version de validation humaine 0.4.0</p></section><nav class='tabs'><button data-tab='dash' class='active'>Tableau de bord</button><button data-tab='tours'>Tournées</button><button data-tab='fleet'>Flotte</button><button data-tab='incidents'>Incidents</button></nav><section id='dash' class='panel active'><div class='grid'><div class='card kpi'><strong id='kTours'>0</strong><span>Tournées</span></div><div class='card kpi'><strong id='kDone'>0</strong><span>Terminées</span></div><div class='card kpi'><strong id='kFleet'>0</strong><span>Véhicules disponibles</span></div><div class='card kpi'><strong id='kInc'>0</strong><span>Incidents ouverts</span></div></div><div class='bar'><h2>Activité récente</h2><button class='btn alt' id='exportBtn'>Exporter les tournées CSV</button></div><div class='tablewrap'><table><thead><tr><th>Code</th><th>Zone</th><th>Date</th><th>Véhicule</th><th>Statut</th><th>Tonnage</th></tr></thead><tbody id='recentRows'></tbody></table></div></section><section id='tours' class='panel'><div class='bar'><h2>Planification des tournées</h2></div><form class='form' id='tourForm'><input name='code' placeholder='Code tournée' required><input name='zone' placeholder='Zone' required><input name='date' type='date' required><input name='vehicle' placeholder='Véhicule'><select name='status'><option value='planifiee'>Planifiée</option><option value='en_cours'>En cours</option><option value='terminee'>Terminée</option><option value='annulee'>Annulée</option></select><input name='tonnage' type='number' min='0' step='1' placeholder='Tonnage kg'><button class='btn'>Ajouter la tournée</button></form><div class='tablewrap'><table><thead><tr><th>Code</th><th>Zone</th><th>Date</th><th>Véhicule</th><th>Statut</th><th>Tonnage</th><th>Action</th></tr></thead><tbody id='tourRows'></tbody></table></div></section><section id='fleet' class='panel'><div class='bar'><h2>Flotte de collecte</h2></div><form class='form' id='fleetForm'><input name='plate' placeholder='Immatriculation' required><input name='label' placeholder='Désignation' required><input name='capacity' type='number' min='1' placeholder='Capacité kg' required><select name='status'><option value='disponible'>Disponible</option><option value='indisponible'>Indisponible</option></select><button class='btn'>Ajouter le véhicule</button></form><div class='tablewrap'><table><thead><tr><th>Immatriculation</th><th>Désignation</th><th>Capacité</th><th>Statut</th><th>Action</th></tr></thead><tbody id='fleetRows'></tbody></table></div></section><section id='incidents' class='panel'><div class='bar'><h2>Registre des incidents</h2></div><form class='form' id='incidentForm'><input name='tour' placeholder='Code tournée'><input name='description' placeholder='Description de l’incident' required><select name='severity'><option value='faible'>Faible</option><option value='moyenne'>Moyenne</option><option value='critique'>Critique</option></select><button class='btn'>Déclarer l’incident</button></form><div class='tablewrap'><table><thead><tr><th>Tournée</th><th>Description</th><th>Sévérité</th><th>Statut</th><th>Action</th></tr></thead><tbody id='incidentRows'></tbody></table></div></section><p class='footer'>Les données saisies pendant la recette sont conservées dans ce navigateur uniquement.</p></div><script>(()=>{const KEY='cdm-validation-v040';const seed={tours:[{id:1,code:'T-001',zone:'Centre-ville',date:new Date().toISOString().slice(0,10),vehicle:'BENNE-01',status:'en_cours',tonnage:3200},{id:2,code:'T-002',zone:'Quartier Nord',date:new Date().toISOString().slice(0,10),vehicle:'BENNE-02',status:'planifiee',tonnage:0},{id:3,code:'T-003',zone:'Marché central',date:new Date(Date.now()-86400000).toISOString().slice(0,10),vehicle:'BENNE-03',status:'terminee',tonnage:4650}],fleet:[{id:1,plate:'AA-001-CDM',label:'Benne compacte 12 m³',capacity:7000,status:'disponible'},{id:2,plate:'AA-002-CDM',label:'Benne tasseuse 16 m³',capacity:9500,status:'disponible'},{id:3,plate:'AA-003-CDM',label:'Camion léger',capacity:3500,status:'indisponible'}],incidents:[{id:1,tour:'T-001',description:'Bac inaccessible, stationnement gênant',severity:'moyenne',status:'ouvert'}]};let db;try{db=JSON.parse(localStorage.getItem(KEY))||seed}catch{db=seed}const save=()=>localStorage.setItem(KEY,JSON.stringify(db));const badge=x=>`<span class='badge ${x}'>${x.replaceAll('_',' ')}</span>`;const esc=x=>String(x??'').replace(/[&<>\"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#039;'}[m]));function render(){document.getElementById('kTours').textContent=db.tours.length;document.getElementById('kDone').textContent=db.tours.filter(x=>x.status==='terminee').length;document.getElementById('kFleet').textContent=db.fleet.filter(x=>x.status==='disponible').length;document.getElementById('kInc').textContent=db.incidents.filter(x=>x.status!=='clos').length;const tourLine=(x,a=true)=>`<tr><td><b>${esc(x.code)}</b></td><td>${esc(x.zone)}</td><td>${esc(x.date)}</td><td>${esc(x.vehicle||'—')}</td><td>${badge(x.status)}</td><td>${Number(x.tonnage||0).toLocaleString('fr-FR')} kg</td>${a?`<td class='actions'><button class='mini' data-next-tour='${x.id}'>Statut suivant</button><button class='mini' data-del-tour='${x.id}'>Supprimer</button></td>`:''}</tr>`;document.getElementById('tourRows').innerHTML=db.tours.length?db.tours.map(x=>tourLine(x)).join(''):`<tr><td colspan='7' class='empty'>Aucune tournée</td></tr>`;document.getElementById('recentRows').innerHTML=db.tours.slice(-5).reverse().map(x=>tourLine(x,false)).join('');document.getElementById('fleetRows').innerHTML=db.fleet.length?db.fleet.map(x=>`<tr><td><b>${esc(x.plate)}</b></td><td>${esc(x.label)}</td><td>${Number(x.capacity).toLocaleString('fr-FR')} kg</td><td>${badge(x.status)}</td><td class='actions'><button class='mini' data-toggle-fleet='${x.id}'>Basculer</button><button class='mini' data-del-fleet='${x.id}'>Supprimer</button></td></tr>`).join(''):`<tr><td colspan='5' class='empty'>Aucun véhicule</td></tr>`;document.getElementById('incidentRows').innerHTML=db.incidents.length?db.incidents.map(x=>`<tr><td>${esc(x.tour||'—')}</td><td>${esc(x.description)}</td><td>${badge(x.severity)}</td><td>${badge(x.status)}</td><td class='actions'><button class='mini' data-close-inc='${x.id}'>${x.status==='clos'?'Rouvrir':'Clore'}</button><button class='mini' data-del-inc='${x.id}'>Supprimer</button></td></tr>`).join(''):`<tr><td colspan='5' class='empty'>Aucun incident</td></tr>`;save()}document.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.panel').forEach(x=>x.classList.toggle('active',x.id===b.dataset.tab))});document.getElementById('tourForm').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target);db.tours.push({id:Date.now(),code:f.get('code'),zone:f.get('zone'),date:f.get('date'),vehicle:f.get('vehicle'),status:f.get('status'),tonnage:Number(f.get('tonnage')||0)});e.target.reset();render()};document.getElementById('fleetForm').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target);db.fleet.push({id:Date.now(),plate:f.get('plate'),label:f.get('label'),capacity:Number(f.get('capacity')),status:f.get('status')});e.target.reset();render()};document.getElementById('incidentForm').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target);db.incidents.push({id:Date.now(),tour:f.get('tour'),description:f.get('description'),severity:f.get('severity'),status:'ouvert'});e.target.reset();render()};document.getElementById('cdm').onclick=e=>{const b=e.target.closest('button');if(!b)return;const next=['planifiee','en_cours','terminee','annulee'];if(b.dataset.nextTour){const x=db.tours.find(x=>x.id==b.dataset.nextTour);x.status=next[(next.indexOf(x.status)+1)%next.length]}if(b.dataset.delTour)db.tours=db.tours.filter(x=>x.id!=b.dataset.delTour);if(b.dataset.toggleFleet){const x=db.fleet.find(x=>x.id==b.dataset.toggleFleet);x.status=x.status==='disponible'?'indisponible':'disponible'}if(b.dataset.delFleet)db.fleet=db.fleet.filter(x=>x.id!=b.dataset.delFleet);if(b.dataset.closeInc){const x=db.incidents.find(x=>x.id==b.dataset.closeInc);x.status=x.status==='clos'?'ouvert':'clos'}if(b.dataset.delInc)db.incidents=db.incidents.filter(x=>x.id!=b.dataset.delInc);render()};document.getElementById('exportBtn').onclick=()=>{const cols=['code','zone','date','vehicle','status','tonnage'];const csv=[cols.join(';'),...db.tours.map(x=>cols.map(k=>`\"${String(x[k]??'').replaceAll('\\\"','\\\"\\\"')}\"`).join(';'))].join('\\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download='cdm-tournees.csv';a.click();URL.revokeObjectURL(a.href)};render()})()</script>",
      "markdown": "",
